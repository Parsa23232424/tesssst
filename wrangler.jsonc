{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tesssst",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "224a71a3-b15b-4334-9bbe-d42543e97500","database_name": "test-vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dc45543428034eb8958e7260f7385b0a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
